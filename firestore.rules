rules_version = '2';
// LANE NOTE firestore.rules（v0.25 で talks を作り直し。2026-10-12。もとは v0.14／記録 v0.6.0 の版）：Astra 監査版をベースに、リポジトリ d489257 の現行ルールと統合
// ※アプリ v0.14 より前の版は、ログインなしの不具合送信がこのルールで断られる。v0.14 を公開してから（または同時に）Firebase コンソールに貼り替えること
// ・users/{uid}/**（records・meets・settings/divOverrides・将来の shareIndex）：本人だけ読み書き（現行と同じ）
// ・shares/{id}：IDを知っていれば期限内だけ読める（expiresAt と createdAt+120日の早い方）。作成はGoogleログイン本人・形式/サイズ/期限を検査。変更不可・一覧不可・削除は本人（期限後も可）
// ・feedback/{id}：Googleログイン必須（匿名送信は停止）。読む・直す・消すはアプリから不可
// ・talks/{tid}（v0.24 選手とのやり取り）：tid は推測できない20文字。顧問（Googleログイン本人）が作る。
//   ID を知っていれば、使える状態（active）かつ期限内（expiresAt と createdAt+120日の早い方）だけ読める。一覧は不可。
//   顧問が変えられるのは active・note・noteAt だけ。消すのは顧問本人だけ。
//   talks/{tid}/msgs/{mid}：選手（ログインなし・リンクだけ）は from:'p' だけ書ける（使える状態・期限内のとき）。顧問本人は from:'t'。
//   直すのは誰も不可。消すのは顧問本人だけ。※あとで選手のログインを選べるようにするときは、talks に選手の uid を足して書き込みを絞る
// ※回数制限ではない。App Check／受付サーバーは別途。
// ・v0.26 teams/{T}（チームで共有）：顧問（coach）とマネージャー（manager）が、それぞれ自分の Google アカウントで同じチームの記録を使う。
//   メンバーは teams/{T}/members/{uid}。マネージャーは期限（expiresAt）を過ぎると、ルールで自動的に読み書きできなくなる。
//   参加は「参加コード」（チームID20文字＋秘密24文字）。試すたびに joinTries/{uid} を1増やす（10秒に1回まで）。コードは顧問だけが見られ、作り直せる。
//   記録（teams/{T}/records）は書くたびに変更履歴（teams/{T}/hist）を同じまとめ書きで残す（前と後の中身をルールで照合）。消すのは「削除の印」だけ。
//   マネージャーが書いた記録は必ず「未確認」（_st:'pending'）。「確認済み」（'ok'）にできるのは顧問だけ。
//   チームの持ち主（ownerUid）を変えられるのは持ち主だけで、渡す相手はチームの顧問だけ。
// ・v0.26.33 teams/{T}/meets/{k}/pdf/{c}：大会準備のPDF（4種類）をチームで共有。ファイルで入れたものだけ・メンバーだけ・大会終了の1か月後まで読める・5MBまで・一覧不可
// ・v0.26.11 記録に aid（選手台帳のID・A＋10文字）と legs（リレーの走順・300文字まで）を追加
// ・v0.26.9 安全面：
//   config/flags（機能の一時停止）：だれでも読める。書けるのは管理者（admins/{uid} がある人。admins は Firebase コンソールでだけ作る）。
//     talk=false でやり取り（選手の読み書き・新しい会話）、share=false で短いリンクの新規作成、counter=false で利用カウンターを止める（記録はそのまま見られる）。
//     relay（URLから読み込む）は画面で止める（中継そのものは Worker の環境変数 RELAY_OFF=1 で止める）。
//   参加コードの制限：期限（exp）・使える回数（max／used）・顧問の承認（approve）。承認が要るコードで入った人は role:'pending'（何も読めない）で、顧問が承認すると want の役割になる。
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function googleUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function owner(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function validShareId(id) {
      return id.matches('^[A-Za-z0-9]{10}$');
    }
    function shareKeys(d) {
      return d.keys().hasAll(['data', 'ownerUid', 'createdAt', 'expiresAt'])
        && d.keys().hasOnly(['data', 'ownerUid', 'createdAt', 'expiresAt']);
    }
    function shareReadable(d) {
      return d.createdAt is timestamp
        && d.expiresAt is timestamp
        && request.time < d.expiresAt
        && request.time < d.createdAt + duration.value(120, 'd');
    }
    function validShare(d) {
      return shareKeys(d)
        && d.ownerUid is string
        && d.ownerUid == request.auth.uid
        && d.data is string
        && d.data.size() >= 3
        && d.data.size() <= 190000
        && d.data.matches('^1[.][A-Za-z0-9_-]+$')
        && d.createdAt == request.time
        && d.expiresAt is timestamp
        && d.expiresAt > request.time
        // Existing clients calculate expiry with Date.now(). Permit up to 5 min
        // positive clock skew, while shareReadable enforces the 120-day ceiling.
        && d.expiresAt <= request.time + duration.value(120, 'd') + duration.value(5, 'm');
    }
    function optionalText(d, key, maxSize) {
      return !(key in d) || (d[key] is string && d[key].size() <= maxSize);
    }
    function validFeedback(d) {
      return d.keys().hasAll(['kind', 'body', 'createdAt', 'uid'])
        && d.keys().hasOnly(['kind', 'body', 'contact', 'page', 'version', 'ua', 'screen', 'path', 'createdAt', 'uid'])
        && d.kind in ['不具合', '要望', 'その他']
        && d.body is string
        && d.body.size() >= 1
        && d.body.size() <= 5000
        && optionalText(d, 'contact', 200)
        && optionalText(d, 'page', 40)
        && optionalText(d, 'version', 60)
        && optionalText(d, 'ua', 500)
        && optionalText(d, 'screen', 80)
        && optionalText(d, 'path', 300)
        && d.createdAt == request.time
        && d.uid is string
        && d.uid == request.auth.uid;
    }

    // v0.26.9 flags ここから 機能の一時停止（config/flags）。文書が無い・項目が無いときは「使える」
    function flagsPath() {
      return /databases/$(database)/documents/config/flags;
    }
    function featureOn(k) {
      return !exists(flagsPath()) || get(flagsPath()).data.get(k, true) != false;
    }
    function isAdmin() {
      return googleUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function validFlags(d) {
      return d.keys().hasOnly(['talk', 'relay', 'counter', 'share', 'note', 'at', 'by'])
        && d.keys().hasAll(['talk', 'relay', 'counter', 'share', 'at', 'by'])
        && d.talk is bool && d.relay is bool && d.counter is bool && d.share is bool
        && optionalText(d, 'note', 200)
        && d.at == request.time
        && d.by == request.auth.uid;
    }
    // v0.26.9 flags ここまで
    // v0.24 talks ここから（v0.25 で作り直し：Astra 第3回監査 C301・C303・C304・C307）
    function validTalkId(id) {
      return id.matches('^[A-Za-z0-9]{20}$');
    }
    function talkPath(tid) {
      return /databases/$(database)/documents/talks/$(tid);
    }
    // 顧問の「選手とのやり取りを使う」がオンのときだけ（設定がない・false なら閉じる）（C304）
    function teamOn(uid) {
      return get(/databases/$(database)/documents/users/$(uid)/settings/talk).data.get('enabled', false) == true;
    }
    // 選手が読み書きできる状態：v2 の形・使用中・閉じていない・期限内・チーム全体がオン
    function talkOpen(d) {
      return d.get('v', 1) == 2
        && d.active == true
        && d.closed == false
        && d.createdAt is timestamp
        && d.expiresAt is timestamp
        && request.time < d.expiresAt
        && request.time < d.createdAt + duration.value(120, 'd')
        && teamOn(d.ownerUid)
        && featureOn('talk');
    }
    function talkOwner(d) {
      return signedIn() && d.ownerUid == request.auth.uid;
    }
    function validTalkNew(d) {
      return d.keys().hasAll(['v', 'ownerUid', 'name', 'note', 'noteAt', 'active', 'closed', 'n', 'lastAt', 'createdAt', 'expiresAt'])
        && d.keys().hasOnly(['v', 'ownerUid', 'name', 'note', 'noteAt', 'active', 'closed', 'n', 'lastAt', 'createdAt', 'expiresAt'])
        && d.v == 2
        && d.ownerUid is string
        && d.ownerUid == request.auth.uid
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.note is string && d.note.size() <= 500
        && d.noteAt == request.time
        && d.active == true
        && d.closed == false
        && d.n is int
        && d.n == 0
        && d.lastAt == request.time
        && d.createdAt == request.time
        && d.expiresAt is timestamp
        && d.expiresAt > request.time
        && d.expiresAt <= request.time + duration.value(120, 'd') + duration.value(5, 'm');
    }
    // 顧問の管理：ひとこと・停止/再開・閉じる（閉じたら二度と開けない・名前とひとことを消す）（C301）
    function validTalkManage(d, old) {
      return !old.get('closed', false)
        && d.diff(old).affectedKeys().hasOnly(['active', 'note', 'noteAt', 'closed', 'name'])
        && d.active is bool
        && d.note is string && d.note.size() <= 500
        && (d.note == old.note || d.noteAt == request.time)
        && d.get('closed', false) is bool
        && (d.get('closed', false) == false
            ? (d.name == old.name)
            : (d.active == false && d.name == '' && d.note == ''));
    }
    // 投稿のたびに数を1つ増やす（同じまとめ書きで msgs/m<n> を作る）。3秒に1回まで・1会話1000件まで（C303）
    function validCounter(tid, d, old) {
      return d.diff(old).affectedKeys().hasOnly(['n', 'lastAt'])
        && talkOpen(old)
        // R252：小数型（1.0 など）は受け付けない。前も後も整数・0〜1000
        && old.n is int && old.n >= 0 && old.n < 1000
        && d.n is int && d.n == old.n + 1 && d.n <= 1000
        && d.lastAt == request.time
        && (old.n == 0 || request.time > old.lastAt + duration.value(3, 's'))
        && existsAfter(/databases/$(database)/documents/talks/$(tid)/msgs/$('m' + string(d.n)));
    }
    function validMsg(d, talkBefore) {
      return d.keys().hasAll(['from', 'body', 'createdAt', 'purgeAt'])
        && d.keys().hasOnly(['from', 'body', 'createdAt', 'purgeAt'])
        && d.from in ['p', 't']
        && d.body is string
        && d.body.size() >= 1
        && d.body.size() <= 500
        && d.createdAt == request.time
        && d.purgeAt == talkBefore.expiresAt;
    }
    // v0.24 talks ここまで

    // v0.26 teams ここから
    function validTeamId(id) {
      return id.matches('^[A-Za-z0-9]{20}$');
    }
    function teamDoc(t) {
      return /databases/$(database)/documents/teams/$(t);
    }
    function memberPath(t, uid) {
      return /databases/$(database)/documents/teams/$(t)/members/$(uid);
    }
    function memberOf(t) {
      return get(memberPath(t, request.auth.uid)).data;
    }
    // 今使えるメンバー：顧問、または期限内のマネージャー（期限切れ・外された人は何もできない）
    function activeMember(t) {
      return signedIn() && exists(memberPath(t, request.auth.uid))
        && (memberOf(t).role == 'coach'
            || (memberOf(t).role == 'manager' && memberOf(t).expiresAt is timestamp && request.time < memberOf(t).expiresAt));
    }
    // v0.26.33 大会準備のPDFのかけら（チーム）
    function validPdfChunk(c, d) {
      return c.matches('^(yoko|sl|tt|note)_[0-9]{1,2}$')
        && d.keys().hasOnly(['kind', 'i', 'n', 'data', 'name', 'size', 'exp', 'by'])
        && d.keys().hasAll(['kind', 'i', 'n', 'data', 'name', 'size', 'exp', 'by'])
        && d.kind in ['yoko', 'sl', 'tt', 'note'] && c == d.kind + '_' + string(d.i)
        && d.i is int && d.n is int && d.i >= 0 && d.i < d.n && d.n <= 10
        && d.data is string && d.data.size() <= 900000
        && d.name is string && d.name.size() <= 200
        && d.size is int && d.size > 0 && d.size <= 5242880
        && d.exp is timestamp && d.exp > request.time && d.exp < request.time + duration.value(430, 'd')
        && d.by == request.auth.uid;
    }
    function isCoach(t) {
      return signedIn() && exists(memberPath(t, request.auth.uid)) && memberOf(t).role == 'coach';
    }
    function teamOwnerUid(t) {
      return get(teamDoc(t)).data.ownerUid;
    }
    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 40;
    }
    // v0.26.9 参加コードの制限：期限（exp）・回数（max/used）。承認が要るコード（approve）は role:'pending' で入る
    function codeOk(c, after) {
      return (!('exp' in c) || request.time < c.exp)
        && (!('max' in c) || (after.get('used', -1) == c.get('used', 0) + 1 && after.used <= c.max));
    }
    function validCodeNew(d) {
      return d.keys().hasAll(['role', 'createdAt', 'by'])
        && d.keys().hasOnly(['role', 'createdAt', 'by', 'mexp', 'exp', 'max', 'used', 'approve'])
        && d.role in ['coach', 'manager']
        && d.createdAt == request.time
        && d.by == request.auth.uid
        && (d.role == 'coach' ? !('mexp' in d) : validMexp(d.mexp))
        && (!('exp' in d) || (d.exp is timestamp && d.exp > request.time && d.exp <= request.time + duration.value(400, 'd')))
        && (!('max' in d) || (d.max is int && d.max >= 1 && d.max <= 100 && d.used is int && d.used == 0))
        && (!('used' in d) || 'max' in d)
        && (!('approve' in d) || d.approve is bool);
    }
    // マネージャーの期限は「今より後・400日以内」
    function validMexp(x) {
      return x is timestamp && x > request.time && x <= request.time + duration.value(400, 'd');
    }
    function histPath(t, hid) {
      return /databases/$(database)/documents/teams/$(t)/hist/$(hid);
    }
    // 記録を書くとき：書いた人・時刻・未確認/確認済み・履歴の番号。履歴には前と後の中身がそのまま入っていること
    // v0.26.1（C404）：記録の形を検査する（決まった項目だけ・文字列/数の型・長さ）。削除の印（_del）なら必須は id だけ
    function optStr(d, k, n) {
      return !(k in d) || (d[k] is string && d[k].size() <= n);
    }
    function optNum(d, k) {
      return !(k in d) || (d[k] is int || d[k] is float || (d[k] is string && d[k].size() <= 20));
    }
    function validRecShape(rid, d) {
      return d.keys().hasOnly(['id', 'name', 'kana', 'grade', 'team', 'event', 'round', 'mark', 'wind', 'comment', 'meet', 'date', 'src', 'savedAt', 'updatedAt', 'lane', 'bib', 'sex', 'dupOf', 'warn',
          'heat', 'rank', 'overall', 'order', 'manual', '_by', '_at', '_st', '_h', '_del', 'aid', 'legs'])
        && d.id is string && d.id.size() >= 1 && d.id.size() <= 400
        && rid == d.id.replace('/', '∕')
        && (d.get('_del', false) == true
            || (d.keys().hasAll(['name', 'event', 'mark', 'meet', 'date'])
                && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                && d.meet is string && d.meet.size() >= 1 && d.event is string && d.event.size() >= 1))
        && optStr(d, 'name', 120) && optStr(d, 'kana', 120) && optStr(d, 'grade', 120) && optStr(d, 'team', 120) && optStr(d, 'event', 120)
        && optStr(d, 'round', 120) && optStr(d, 'mark', 120) && optStr(d, 'wind', 120) && optStr(d, 'comment', 300) && optStr(d, 'meet', 120)
        && optStr(d, 'date', 120) && optStr(d, 'src', 300) && optStr(d, 'savedAt', 120) && optStr(d, 'updatedAt', 120) && optStr(d, 'lane', 120)
        && optStr(d, 'bib', 120) && optStr(d, 'sex', 120) && optStr(d, 'dupOf', 400) && optStr(d, 'warn', 300)
        && optNum(d, 'heat') && optNum(d, 'rank') && optNum(d, 'overall') && optNum(d, 'order')
        && (!('manual' in d) || d.manual is bool)
        && (!('aid' in d) || (d.aid is string && d.aid.matches('^A[A-Za-z0-9]{10}$'))) && optStr(d, 'legs', 300);   // v0.26.11 選手台帳のID・リレーの走順
    }
    function validTeamRecord(t, rid, d) {
      return validRecShape(rid, d)
        && d._by == request.auth.uid
        && d._at == request.time
        && d._st in ['pending', 'ok']
        && (d._st == 'pending' || isCoach(t))
        && d._h is string && d._h.matches('^[A-Za-z0-9]{20}$')
        && d.get('_del', false) is bool
        && getAfter(histPath(t, d._h)).data.rid == rid
        && getAfter(histPath(t, d._h)).data.uid == request.auth.uid
        && getAfter(histPath(t, d._h)).data.at == request.time
        && getAfter(histPath(t, d._h)).data.after == d
        && getAfter(histPath(t, d._h)).data.before == (resource == null ? null : resource.data);
    }
    // v0.26.1（C405）：名前はメンバー文書の名前と同じ。操作の種類は前後の中身と合っていること（確認済みには顧問だけ）
    function validAct(t, d) {
      return (d.act == 'del' ? d.after.get('_del', false) == true : d.after.get('_del', false) == false || d.act == 'revert')
        && (d.act in ['add', 'migrate'] ? (d.before == null || d.before.get('_del', false) == true) : true)
        && (d.act in ['edit', 'confirm', 'del'] ? d.before != null : true)
        && (d.act == 'confirm' ? (isCoach(t) && d.before.get('_st', '') == 'pending' && d.after._st == 'ok') : true);
    }
    function validHist(t, d) {
      return d.name == memberOf(t).name
        && validAct(t, d)
        && d.keys().hasAll(['rid', 'uid', 'name', 'at', 'act', 'before', 'after'])
        && d.keys().hasOnly(['rid', 'uid', 'name', 'at', 'act', 'before', 'after'])
        && d.rid is string && d.rid.size() >= 1 && d.rid.size() <= 400
        && d.uid == request.auth.uid
        && validName(d.name)
        && d.at == request.time
        && d.act in ['add', 'edit', 'del', 'revert', 'confirm', 'migrate']
        && (d.before == null || d.before is map)
        && d.after is map;
    }
    // v0.26 teams ここまで

    // Preserve the existing owner-only users subtree for compatibility with
    // records, weather, division settings, and existing user-owned data.
    // This rule does not validate record schemas or enforce storage quotas.
    match /users/{userId}/{document=**} {
      allow read, write: if owner(userId);
    }
    match /shares/{shareId} {
      allow get: if validShareId(shareId) && shareReadable(resource.data);
      allow list: if false;
      allow create: if googleUser() && validShareId(shareId)
        && validShare(request.resource.data)
        && featureOn('share');
      allow update: if false;
      // Owners can delete even after expiry. No client may change ownership.
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
    // v0.24 talks ここから
    match /talks/{tid} {
      allow get: if validTalkId(tid) && (talkOpen(resource.data) || talkOwner(resource.data));
      allow list: if false;
      // 一度使ったIDは本体を消さない（閉じた印として残す）ので、同じIDで作り直せない（C301）
      allow create: if googleUser() && validTalkId(tid) && validTalkNew(request.resource.data) && featureOn('talk');
      allow update: if validTalkId(tid) && (
        (talkOwner(resource.data) && validTalkManage(request.resource.data, resource.data))
        || validCounter(tid, request.resource.data, resource.data));
      allow delete: if false;
      match /msgs/{mid} {
        function talkBefore() {
          return get(talkPath(tid)).data;
        }
        function talkAfter() {
          return getAfter(talkPath(tid)).data;
        }
        allow get: if validTalkId(tid) && (talkOpen(talkBefore()) || talkOwner(talkBefore()));
        // 一度に読むのは50件まで（C303）
        allow list: if validTalkId(tid) && request.query.limit <= 50
          && (talkOpen(talkBefore()) || talkOwner(talkBefore()));
        // 体調メモ（cond）は v0.25 では受け付けない（選手のログインができるまで止める：C302・C306）
        allow create: if validTalkId(tid)
          && talkOpen(talkBefore())
          && validMsg(request.resource.data, talkBefore())
          && talkAfter().n == talkBefore().n + 1
          && mid == 'm' + string(talkAfter().n)
          && (request.resource.data.from == 'p' || talkOwner(talkBefore()));
        allow update: if false;
        allow delete: if validTalkId(tid) && talkOwner(talkBefore());
      }
    }
    // v0.24 talks ここまで
    // v0.26 teams ここから
    match /teams/{t} {
      allow get: if validTeamId(t) && activeMember(t);
      allow list: if false;
      // 作るときは、同じまとめ書きで自分を顧問として members に入れる
      allow create: if googleUser() && validTeamId(t)
        && request.resource.data.keys().hasAll(['v', 'name', 'ownerUid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['v', 'name', 'ownerUid', 'createdAt'])
        && request.resource.data.v == 1
        && validName(request.resource.data.name)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(memberPath(t, request.auth.uid)).data.role == 'coach';
      // 名前は顧問なら変えられる。持ち主を渡すのは持ち主だけ・相手はこのチームの顧問
      allow update: if validTeamId(t) && isCoach(t)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'ownerUid'])
        && validName(request.resource.data.name)
        && (request.resource.data.ownerUid == resource.data.ownerUid
            || (resource.data.ownerUid == request.auth.uid
                && exists(memberPath(t, request.resource.data.ownerUid))
                && get(memberPath(t, request.resource.data.ownerUid)).data.role == 'coach'
                && existsAfter(memberPath(t, request.resource.data.ownerUid))
                && getAfter(memberPath(t, request.resource.data.ownerUid)).data.role == 'coach'));
      allow delete: if false;

      match /members/{uid} {
        function joinTry() {
          return get(/databases/$(database)/documents/joinTries/$(uid)).data;
        }
        allow list: if activeMember(t);
        // v0.26.9：承認待ち（pending）の本人は、自分の文書だけ読める（承認されたかを知るため）
        allow get: if activeMember(t) || (signedIn() && uid == request.auth.uid);
        // ① チームを作った本人（顧問）② 参加コードで入る本人（直前に joinTries にそのコードを書いてあること）
        // v0.26.1（C401）：参加の秘密は members に入れない（全員が読めるため）。照合は本人だけが読める joinTries の code を使う
        // v0.26.1（C402）：外された人（banned）は、顧問が「再参加を許可」するまで入れない
        allow create: if googleUser() && validTeamId(t) && uid == request.auth.uid
          && request.resource.data.keys().hasAll(['role', 'name', 'joinedAt'])
          && request.resource.data.keys().hasOnly(['role', 'name', 'joinedAt', 'expiresAt', 'want'])
          && validName(request.resource.data.name)
          && request.resource.data.joinedAt == request.time
          && (
            (!exists(teamDoc(t)) && getAfter(teamDoc(t)).data.ownerUid == uid
              && request.resource.data.role == 'coach' && !('expiresAt' in request.resource.data))
            || (exists(teamDoc(t))
              && !exists(/databases/$(database)/documents/teams/$(t)/banned/$(uid))
              && joinTry().team == t
              && request.time < joinTry().lastAt + duration.value(2, 'm')
              && exists(/databases/$(database)/documents/teams/$(t)/codes/$(joinTry().code))
              && codeOk(get(/databases/$(database)/documents/teams/$(t)/codes/$(joinTry().code)).data,
                        getAfter(/databases/$(database)/documents/teams/$(t)/codes/$(joinTry().code)).data)
              && (get(/databases/$(database)/documents/teams/$(t)/codes/$(joinTry().code)).data.get('approve', false) == true
                  ? (request.resource.data.role == 'pending'
                     && request.resource.data.want == get(/databases/$(database)/documents/teams/$(t)/codes/$(joinTry().code)).data.role)
                  : (get(/databases/$(database)/documents/teams/$(t)/codes/$(joinTry().code)).data.role == request.resource.data.role
                     && !('want' in request.resource.data)))
              && (get(/databases/$(database)/documents/teams/$(t)/codes/$(joinTry().code)).data.role == 'coach'
                  ? !('expiresAt' in request.resource.data)
                  : request.resource.data.expiresAt == get(/databases/$(database)/documents/teams/$(t)/codes/$(joinTry().code)).data.mexp))
          );
        // 顧問：ほかの人の役割・期限を変えられる（持ち主は顧問のまま）。本人：名前だけ
        allow update: if (isCoach(t) && uid != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'expiresAt', 'want'])
            && request.resource.data.role in ['coach', 'manager']
            && !('want' in request.resource.data)
            && (resource.data.role != 'pending' || request.resource.data.role == resource.data.want)
            && (request.resource.data.role == 'coach' || request.resource.data.expiresAt is timestamp)
            && (request.resource.data.role == 'coach' || request.resource.data.expiresAt <= request.time + duration.value(400, 'd'))
            && uid != teamOwnerUid(t) && uid != getAfter(teamDoc(t)).data.ownerUid)
          || (uid == request.auth.uid && activeMember(t)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && validName(request.resource.data.name));
        // 顧問はほかの人を外せる・本人は抜けられる（持ち主はどちらも不可。先に持ち主を渡す）
        // v0.26.1（C402）：顧問が外すときは、同じまとめ書きで banned に入れる（外したあと同じコードで戻れない）。C406：処理後の持ち主も外せない
        allow delete: if uid != teamOwnerUid(t) && uid != getAfter(teamDoc(t)).data.ownerUid
          && ((isCoach(t) && uid != request.auth.uid && existsAfter(/databases/$(database)/documents/teams/$(t)/banned/$(uid)))
              || (isCoach(t) && resource.data.role == 'pending')
              || (signedIn() && uid == request.auth.uid));
      }
      // v0.26.1（C402）：外した人の印。顧問だけが見る・作る・消す（消す＝再参加を許可）
      match /banned/{uid} {
        // v0.26.35：外された本人は、自分の印だけ読める（参加できない理由を出すため。名前・日時は自分のもの）
        allow get: if isCoach(t) || (signedIn() && uid == request.auth.uid);
        allow list: if isCoach(t);
        allow create: if isCoach(t) && uid != request.auth.uid && uid != teamOwnerUid(t)
          && request.resource.data.keys().hasAll(['name', 'by', 'at'])
          && request.resource.data.keys().hasOnly(['name', 'by', 'at'])
          && validName(request.resource.data.name)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time;
        allow update: if false;
        allow delete: if isCoach(t);
      }
      // 参加コード（文書のIDが秘密の24文字）：顧問だけが見る・作る・消す
      match /codes/{code} {
        allow get, list: if isCoach(t);
        allow create: if isCoach(t) && code.matches('^[A-Za-z0-9]{24}$') && validCodeNew(request.resource.data);
        // v0.26.9：回数の制限があるコードは、入る本人が同じまとめ書きで used を1増やす（ほかの項目は変えられない）
        allow update: if signedIn() && 'max' in resource.data
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
          && request.resource.data.used is int
          && request.resource.data.used == resource.data.used + 1
          && request.resource.data.used <= resource.data.max
          && get(/databases/$(database)/documents/joinTries/$(request.auth.uid)).data.team == t
          && get(/databases/$(database)/documents/joinTries/$(request.auth.uid)).data.code == code
          && !exists(memberPath(t, request.auth.uid))
          && existsAfter(memberPath(t, request.auth.uid));
        allow delete: if isCoach(t);
      }
      // 記録：メンバー（顧問・期限内のマネージャー）が読み書き。書くたびに履歴。消すのは「削除の印」（_del）だけ
      match /records/{rid} {
        allow get, list: if activeMember(t);
        allow create, update: if activeMember(t) && validTeamRecord(t, rid, request.resource.data);
        allow delete: if false;
      }
      // 変更履歴：だれが・いつ・何を。あとから直す・消すのは不可
      match /hist/{hid} {
        allow get, list: if activeMember(t);
        allow create: if activeMember(t) && hid.matches('^[A-Za-z0-9]{20}$') && validHist(t, request.resource.data)
          && getAfter(/databases/$(database)/documents/teams/$(t)/records/$(request.resource.data.rid)).data._h == hid;
        allow update, delete: if false;
      }
      // 大会ごとの天気など：メンバーが読み書き
      match /meets/{k} {
        allow read, write: if activeMember(t);
      }
      // v0.26.33 大会準備のPDF（要項・スタートリスト・タイムテーブル・注意事項）をチームで共有。ファイルで入れたものだけ（URLから読んだものはURLだけを大会の印に）。最大10個に分けた base64（1個 90万文字まで・元のファイル 5MB まで）
      // 読めるのはメンバーだけ・期限（exp＝大会の終わりの日＋30日。大会終了の1か月後に自動で消えます）まで。一覧は不可（大会の印 prep.files に書いた ID で読む）。消すのはメンバー（期限後も可）
      match /meets/{k}/pdf/{c} {
        allow get: if activeMember(t) && resource.data.exp > request.time;
        allow list: if false;
        allow create, update: if activeMember(t) && validPdfChunk(c, request.resource.data);
        allow delete: if activeMember(t);
      }
      // 設定：中学/高校の選択（divOverrides）はメンバー、それ以外は顧問だけ
      match /settings/{sid} {
        allow read: if activeMember(t);
        allow write: if sid == 'divOverrides' ? activeMember(t) : isCoach(t);
      }
    }
    // 参加を試した回数（本人だけ）。試すたびに +1・10秒に1回まで。直前に試したチームとコードを残し、members の作成で照合する
    match /joinTries/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list, delete: if false;
      allow create: if googleUser() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['n', 'lastAt', 'team', 'code'])
        && request.resource.data.n == 1
        && request.resource.data.lastAt == request.time
        && request.resource.data.team is string && validTeamId(request.resource.data.team)
        && request.resource.data.code is string && request.resource.data.code.matches('^[A-Za-z0-9]{24}$');
      allow update: if googleUser() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['n', 'lastAt', 'team', 'code'])
        && request.resource.data.n is int && request.resource.data.n == resource.data.n + 1
        && request.resource.data.lastAt == request.time
        && request.time > resource.data.lastAt + duration.value(10, 's')
        && request.resource.data.team is string && validTeamId(request.resource.data.team)
        && request.resource.data.code is string && request.resource.data.code.matches('^[A-Za-z0-9]{24}$');
    }
    // v0.26 teams ここまで
    // v0.25.4 stats ここから
    // 利用カウンター：誰でも読める。書けるのは「ちょうど1増やす」だけ（項目は整数 n の1つだけ・削除不可）。文書がないときだけ n=1 で作れる
    match /stats/{sid} {
      allow get: if sid == 'counter';
      allow list: if false;
      // v0.26.1（C407）：全体で2秒に1回まで（at＝前に数えた時刻）。水増し・書き込み回数の上限を決める（1日最大43200回）
      allow create: if sid == 'counter' && featureOn('counter')
        && request.resource.data.keys().hasOnly(['n', 'at'])
        && request.resource.data.n is int && request.resource.data.n == 1
        && request.resource.data.at == request.time;
      allow update: if sid == 'counter' && featureOn('counter')
        && request.resource.data.keys().hasOnly(['n', 'at'])
        && request.resource.data.n is int && resource.data.n is int
        && request.resource.data.n == resource.data.n + 1
        && request.resource.data.at == request.time
        && (!('at' in resource.data) || request.time > resource.data.at + duration.value(2, 's'));
      allow delete: if false;
    }
    // v0.25.4 stats ここまで
    // v0.26.9 flags ここから だれでも読める・管理者だけが書ける。管理者の印（admins）はコンソールでだけ作る
    match /config/{cid} {
      allow get: if cid == 'flags';
      allow list: if false;
      allow create, update: if cid == 'flags' && isAdmin() && validFlags(request.resource.data);
      allow delete: if false;
    }
    match /admins/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list, write: if false;
    }
    // v0.26.9 flags ここまで
    // v0.26.35 みんなの要項 ここから
    // pubQuota/{uid}：登録・報告の回数（本人だけ読める）。書くたびに at＝今。30秒に1回・1日20回まで。team の顧問であること
    function pubDay() {
      return math.floor(request.time.toMillis() / 86400000);
    }
    function validQuota(uid, d) {
      return googleUser() && uid == request.auth.uid
        && d.keys().hasOnly(['team', 'at', 'day', 'n'])
        && d.team is string && validTeamId(d.team) && isCoach(d.team)
        && d.at == request.time && d.day == pubDay() && d.n is int
        && (resource == null
              ? d.n == 1
              : (request.time > resource.data.at + duration.value(30, 's')
                 && ((resource.data.day == d.day && d.n == resource.data.n + 1 && d.n <= 20)
                     || (resource.data.day != d.day && d.n == 1))));
    }
    // 同じ書き込みで pubQuota を書いていること（＝回数の制限・顧問の確認を通った）
    function pubQuotaNow() {
      return getAfter(/databases/$(database)/documents/pubQuota/$(request.auth.uid)).data;
    }
    function pubCoachNow() {
      return googleUser() && pubQuotaNow().at == request.time && isCoach(pubQuotaNow().team);
    }
    function pubUrl(u) {
      return u is string && u.size() <= 1000 && u.matches('^https://[A-Za-z0-9.-]+[.][A-Za-z]{2,}(/.*)?$');
    }
    function validPubNew(id, d) {
      return d.keys().hasOnly(['name', 'key', 'date', 'end', 'venue', 'url', 'host', 'info', 'by', 'at', 'exp', 'ver', 'rep', 'hid'])
        && d.keys().hasAll(['name', 'key', 'date', 'end', 'venue', 'url', 'host', 'info', 'by', 'at', 'exp', 'ver', 'rep', 'hid'])
        && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9a-f]{8}$') && d.date is string && id.split('_')[0] == d.date
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 100 && d.key is string && d.key.size() <= 100
        && d.end is string && d.end.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.end >= d.date
        && d.venue is string && d.venue.size() <= 60
        && pubUrl(d.url) && d.host is string && d.host.size() <= 200
        && d.info is string && d.info.size() <= 8000
        && d.by == request.auth.uid && d.at == request.time
        && d.exp is timestamp && d.exp > request.time && d.exp < request.time + duration.value(430, 'd')
        && d.ver == 1 && d.rep == 0 && d.hid == false;
    }
    match /pubQuota/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list, delete: if false;
      allow create, update: if validQuota(uid, request.resource.data);
    }
    match /pubMeets/{id} {
      // 読む：ログインした人。報告で隠れたもの（hid）は読めない。一覧は20件まで・hid==false の条件つきだけ
      allow get: if signedIn() && resource.data.hid == false;
      allow list: if signedIn() && request.query.limit <= 20 && resource.data.hid == false;
      allow create: if pubCoachNow() && validPubNew(id, request.resource.data);
      // 差し替え：URL・情報・登録した人・時刻・版だけ（大会名・日付・期限・報告は変えられない）。隠れたものは差し替えられない
      allow update: if pubCoachNow() && resource.data.hid == false
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['url', 'host', 'info', 'by', 'at', 'ver'])
             && pubUrl(request.resource.data.url) && request.resource.data.host is string && request.resource.data.host.size() <= 200
             && request.resource.data.info is string && request.resource.data.info.size() <= 8000
             && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
             && request.resource.data.ver == resource.data.ver + 1)
          // 報告：rep を1つ増やすだけ（同じ書き込みで reports/{自分} を作る＝1人1回）。3件で hid
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rep', 'hid'])
             && request.resource.data.rep == resource.data.rep + 1
             && request.resource.data.hid == (request.resource.data.rep >= 3)
             && !exists(/databases/$(database)/documents/pubMeets/$(id)/reports/$(request.auth.uid))
             && existsAfter(/databases/$(database)/documents/pubMeets/$(id)/reports/$(request.auth.uid))));
      // 消す：登録した本人・期限が過ぎたもの（ログインした人ならだれでも片づけられる）・管理者
      allow delete: if signedIn() && (resource.data.by == request.auth.uid || resource.data.exp < request.time || isAdmin());
      match /reports/{uid} {
        allow get: if signedIn() && uid == request.auth.uid;
        allow list, update, delete: if false;
        allow create: if pubCoachNow() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
          && getAfter(/databases/$(database)/documents/pubMeets/$(id)).data.rep == get(/databases/$(database)/documents/pubMeets/$(id)).data.rep + 1;
      }
    }
    // v0.26.35 みんなの要項 ここまで
    match /feedback/{id} {
      // Behaviour change: signed-out and Firebase-anonymous users cannot submit.
      allow create: if googleUser() && validFeedback(request.resource.data);
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
